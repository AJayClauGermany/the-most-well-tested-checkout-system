<!--
  Settings shared by EVERY project in this folder (MSBuild picks this file up
  automatically). Putting them here keeps each .csproj file short.
-->
<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The compiler warns us when something might be null. -->
    <Nullable>enable</Nullable>

    <!-- A warning is a bug we have not met yet: fail the build instead. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      Write packages.lock.json next to each project, so every machine (and CI)
      restores exactly the same package versions.
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
