<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for src/Checkout. Shared settings live in ../../Directory.Build.props.
    xUnit v3 test projects are small programs (OutputType Exe) that
    `dotnet test` starts through Microsoft.Testing.Platform.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>CheckoutSystem.UnitTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every test file can use [Fact], [Theory] and Assert without a `using Xunit;` line. -->
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Checkout\Checkout.csproj" />
  </ItemGroup>

</Project>
