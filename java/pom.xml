<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file for the Java checkout system.

  Maven reads this file to know:
    * which libraries we use (the <dependencies> section),
    * how to compile the code (maven-compiler-plugin),
    * how to run the tests (maven-surefire-plugin for unit tests,
      maven-failsafe-plugin for integration tests).

  Every version is written out exactly (no ranges, no "latest"), so everybody
  who builds this project gets the same libraries. Maven has no separate
  lockfile: this file *is* the lock.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>checkout</groupId>
  <artifactId>checkout</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Checkout (Java)</name>
  <description>The most well-tested checkout system - Java implementation</description>

  <properties>
    <!-- Compile for Java 21. -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Library versions -->
    <jackson.version>3.3.0</jackson.version>
    <junit.version>6.1.3</junit.version>

    <!-- Plugin versions (pinned so builds are repeatable) -->
    <maven-clean-plugin.version>3.5.0</maven-clean-plugin.version>
    <maven-resources-plugin.version>3.5.0</maven-resources-plugin.version>
    <maven-compiler-plugin.version>3.16.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.6.1</maven-surefire-plugin.version>
    <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
    <maven-jar-plugin.version>3.5.1</maven-jar-plugin.version>
    <maven-install-plugin.version>3.2.0</maven-install-plugin.version>
    <maven-deploy-plugin.version>3.2.0</maven-deploy-plugin.version>
    <maven-site-plugin.version>3.22.0</maven-site-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- The JUnit "bill of materials" keeps all JUnit modules on the same version. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Jackson turns JSON text into Java objects (and back again). -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- JUnit Jupiter: the test framework (includes @ParameterizedTest).
         scope "test" means it is only used by the tests, never by the real program. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Plugins Maven uses behind the scenes. We only pin their versions. -->
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>${maven-deploy-plugin.version}</version>
        </plugin>
        <plugin>
          <artifactId>maven-site-plugin</artifactId>
          <version>${maven-site-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- The compiler. "-Xlint:all -Werror" is our static check:
           the Java compiler reports every warning it knows about,
           and any warning fails the build. -->
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Surefire runs the UNIT tests (classes named *Test) during "mvn test". -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
      </plugin>

      <!-- Failsafe runs the INTEGRATION tests (classes named *IT) during "mvn verify".
           It runs after the jar is built, and it only fails the build at the very end,
           so clean-up steps still get a chance to run. -->
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven-failsafe-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
