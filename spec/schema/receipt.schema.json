{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipt",
  "description": "The checkout output (rules §5). Every amount is a whole number of cents. This schema is the 'contract' that every language's receipt JSON must honour, so it is used by contract tests and by the end-to-end runner.",
  "type": "object",
  "required": ["lines", "subtotal", "promotion_discount", "coupon_discount", "shipping", "tax", "total"],
  "additionalProperties": false,
  "properties": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "name", "quantity", "unit_price", "line_total", "line_discount"],
        "additionalProperties": false,
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 99 },
          "unit_price": { "$ref": "#/$defs/cents" },
          "line_total": { "$ref": "#/$defs/cents" },
          "line_discount": { "$ref": "#/$defs/cents" }
        }
      }
    },
    "subtotal": { "$ref": "#/$defs/cents" },
    "promotion_discount": { "$ref": "#/$defs/cents" },
    "coupon_discount": { "$ref": "#/$defs/cents" },
    "shipping": { "enum": [0, 499, 999] },
    "tax": { "$ref": "#/$defs/cents" },
    "total": { "$ref": "#/$defs/cents" }
  },
  "$defs": {
    "cents": { "type": "integer", "minimum": 0 }
  }
}
